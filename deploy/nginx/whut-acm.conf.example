limit_req_zone $binary_remote_addr zone=whut_api:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=whut_auth:10m rate=10r/m;

server {
    listen 80;
    server_name acm.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name acm.example.com;

    # Managed by Certbot after issuing the certificate.
    ssl_certificate /etc/letsencrypt/live/acm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/acm.example.com/privkey.pem;

    root /var/www/whut-acm;
    index index.html;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /api/auth/login {
        limit_req zone=whut_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/users/register {
        limit_req zone=whut_auth burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=whut_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|webp|gif|svg|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
